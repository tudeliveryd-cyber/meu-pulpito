rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo el dueño de la app (su correo) es administrador
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'tudeliveryd@gmail.com';
    }
    // Cada pastor lee y escribe SOLO sus propios sermones, agenda, biblioteca y preferencias.
    // El administrador NO está incluido aquí: el contenido queda cerrado también para él.
    match /pulpito/{uid}/{rest=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Estadísticas (solo números): cada uno escribe la suya; solo el administrador las lee.
    match /stats/{uid} {
      allow read: if isAdmin();
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // Plan y acceso de cada cuenta: el pastor solo lo lee; solo el administrador lo cambia.
    // Precios, límites del plan gratis, textos y testimonios del sitio: públicos (el sitio los muestra); solo el administrador cambia.
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Visitas del sitio (solo números por día, sin datos personales): cualquiera suma 1; solo el administrador lee.
    function siteKeys() {
      return ['v','u','go','wa','es','pt','mob','dsk','cPY','cBR','cAR','cBO','cUS','cOT','rIG','rFB','rGG','rWA','rDI'];
    }
    function step(k) {
      return request.resource.data.get(k, 0) - (resource == null ? 0 : resource.data.get(k, 0)) in [0, 1];
    }
    function stepsOk() {
      return step('v') && step('u') && step('go') && step('wa') && step('es') && step('pt') && step('mob') && step('dsk')
        && step('cPY') && step('cBR') && step('cAR') && step('cBO') && step('cUS') && step('cOT')
        && step('rIG') && step('rFB') && step('rGG') && step('rWA') && step('rDI');
    }
    match /siteStats/{day} {
      allow read, delete: if isAdmin();
      allow create, update: if day.matches('^20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]$')
        && request.resource.data.keys().hasOnly(siteKeys()) && stepsOk();
    }
    match /planos/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
  }
}
