rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo el dueño de la app (su correo) es administrador
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'tudeliveryd@gmail.com';
    }
    // Cada pastor lee y escribe SOLO sus propios sermones, agenda, biblioteca y preferencias.
    // El administrador NO está incluido aquí: el contenido queda cerrado también para él.
    match /pulpito/{uid}/{rest=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Estadísticas (solo números): cada uno escribe la suya; solo el administrador las lee.
    match /stats/{uid} {
      allow read: if isAdmin();
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // Plan y acceso de cada cuenta: el pastor solo lo lee; solo el administrador lo cambia.
    // Precios, límites del plan gratis, textos y testimonios del sitio: públicos (el sitio los muestra); solo el administrador cambia.
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Visitas del sitio (solo números por día, sin datos personales): cualquiera suma 1; solo el administrador lee.
    function siteKeys() {
      return ['v','u','go','wa','es','pt','mob','dsk','cPY','cBR','cAR','cBO','cUS','cOT','rIG','rFB','rGG','rWA','rDI'];
    }
    function step(k) {
      return request.resource.data.get(k, 0) - (resource == null ? 0 : resource.data.get(k, 0)) in [0, 1];
    }
    function stepsOk() {
      return step('v') && step('u') && step('go') && step('wa') && step('es') && step('pt') && step('mob') && step('dsk')
        && step('cPY') && step('cBR') && step('cAR') && step('cBO') && step('cUS') && step('cOT')
        && step('rIG') && step('rFB') && step('rGG') && step('rWA') && step('rDI');
    }
    match /siteStats/{day} {
      allow read, delete: if isAdmin();
      allow create, update: if day.matches('^20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]$')
        && request.resource.data.keys().hasOnly(siteKeys()) && stepsOk();
    }
    // Testimonios que el pastor envía desde la app: cada uno escribe el suyo; solo el administrador los lee todos.
    match /depo/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['q','n','r','ok','lang','email','at'])
        && request.resource.data.q is string && request.resource.data.q.size() <= 600
        && request.resource.data.n is string && request.resource.data.n.size() <= 80
        && request.resource.data.r is string && request.resource.data.r.size() <= 120
        && request.resource.data.ok is bool;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Roleta de desconto de quem entrou pelo link de um pastor: um giro só (o resultado não pode ser trocado pelo usuário).
    match /roleta/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['p','at','ref'])
        && request.resource.data.p in [5,10,15,20,30,50]
        && request.resource.data.ref is string && request.resource.data.ref.size() <= 12;
      allow update, delete: if isAdmin();
    }
    // Página pública do pastor (meupulpito.com/p/#uid): qualquer um lê; só o próprio pastor escreve, com campos limitados.
    match /pub/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['on','n','ch','city','msg','wa','ig','ev','lang','photo','rp','upd'])
        && request.resource.data.on is bool
        && request.resource.data.n is string && request.resource.data.n.size() <= 80
        && request.resource.data.ch is string && request.resource.data.ch.size() <= 80
        && request.resource.data.city is string && request.resource.data.city.size() <= 60
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 300
        && request.resource.data.wa is string && request.resource.data.wa.size() <= 20
        && request.resource.data.ig is string && request.resource.data.ig.size() <= 40
        && request.resource.data.photo is string && request.resource.data.photo.size() <= 90000
        && request.resource.data.ev is list && request.resource.data.ev.size() <= 6;
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
    // Atendimento: conversa de cada pastor com o suporte. Só ele e o administrador leem.
    match /suporte/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['n','e','l','last','at','ua','uu'])
        && request.resource.data.last is string && request.resource.data.last.size() <= 200;
      match /m/{mid} {
        allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
        allow create: if request.auth != null && request.resource.data.keys().hasOnly(['t','f','at'])
          && request.resource.data.t is string && request.resource.data.t.size() <= 2000
          && ((request.auth.uid == uid && request.resource.data.f == 'u') || (isAdmin() && request.resource.data.f == 'a'));
        allow delete: if isAdmin();
      }
    }
    // Mensagens do formulário «Fale conosco» do site (sem conta). Qualquer um envia; só o administrador lê.
    match /contato/{id} {
      allow create: if request.resource.data.keys().hasOnly(['n','wa','q','l','at'])
        && request.resource.data.n is string && request.resource.data.n.size() > 0 && request.resource.data.n.size() <= 80
        && request.resource.data.wa is string && request.resource.data.wa.size() <= 30
        && request.resource.data.q is string && request.resource.data.q.size() > 0 && request.resource.data.q.size() <= 1500;
      allow read, update, delete: if isAdmin();
    }
    match /planos/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
      // Prueba Premium de 72 horas: la cuenta nueva la crea UNA sola vez (si ya existe el plan, no puede crearla de nuevo)
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['trial','trialFrom','trialAuto','trialState','updated'])
        && request.resource.data.trialAuto == true && request.resource.data.trialState == 'active'
        && request.resource.data.trialFrom is int && request.resource.data.trial is int
        && request.resource.data.trial == request.resource.data.trialFrom + 259200000
        && request.resource.data.trialFrom > request.time.toMillis() - 600000
        && request.resource.data.trialFrom < request.time.toMillis() + 600000;
    }
  }
}
